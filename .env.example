# Copia este archivo a .env y rellena tus valores. NO subas el .env real.

# ── Obligatorio ──────────────────────────────────────────────────────────────
# El token lo obtienes de @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=tu_token_aqui

# ── Opcional ─────────────────────────────────────────────────────────────────
# xpub PÚBLICA para las donaciones (de tu wallet, ej. Sparrow). Empieza con xpub/zpub.
DONATION_XPUB=tu_xpub_publica_aqui

# Tu Telegram ID (o varios separados por coma) para usar /broadcast y /stats.
ADMIN_IDS=tu_telegram_id_aqui

# Conexión a Postgres. Activa el guardado de usuarios y /broadcast.
# Sin ella el bot funciona igual, pero no recuerda a nadie.
DATABASE_URL=postgresql://usuario:password@host:5432/dbname

# ── Nodo Bitcoin propio (opcional, pero es lo que hace privado al bot) ────────
# Sin estas variables el bot usa la API pública de mempool.space y funciona
# perfectamente. Con ellas, las consultas de direcciones y transacciones las
# resuelve TU nodo y no salen a ninguna empresa.
#
# MEMPOOL_BASE  -> tu instancia de Mempool (comisiones, altura de bloque)
# ELECTRS_HOST  -> tu Electrs, que es quien resuelve direcciones y transacciones
#
# MEMPOOL_BASE=http://tu-nodo:3006
# ELECTRS_HOST=tu-nodo
# ELECTRS_PORT=50001
